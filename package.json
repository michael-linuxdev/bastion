{
  "name": "bastion",
  "version": "0.0.0",
  "private": true,
  "description": "Offline-fähige, datenschutzstarke Lern-App für Klasse 5–13 – Baue deine Bastion.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc -p tsconfig.node.json",
    "lint": "eslint . && prettier --check . && pnpm check",
    "format": "prettier --write .",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "budget": "node tools/groessenbudget.ts",
    "grafik:stufen": "python3 tools/grafik/stufen-vergleich.py",
    "messen": "node tools/messung.ts",
    "inhalte:pruefen": "vitest run tools/inhalte --silent=false",
    "inhalte:begriffe": "node --experimental-strip-types --no-warnings --import ./tools/ts-aufloesen.mjs tools/inhalte/begriffe-markieren.ts",
    "review": "node --experimental-strip-types --no-warnings --import ./tools/ts-aufloesen.mjs tools/review/lauf.ts",
    "sim": "node --experimental-strip-types --no-warnings --import ./tools/ts-aufloesen.mjs tools/sim/lauf.ts",
    "pruefbogen": "node --experimental-strip-types --no-warnings tools/pruefbogen/lauf.ts",
    "testnummern": "node --experimental-strip-types --no-warnings --import ./tools/ts-aufloesen.mjs tools/testnummern.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-boundaries": "7.4.0",
    "eslint-plugin-svelte": "3.23.1",
    "fake-indexeddb": "6.2.5",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.3",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5",
    "workbox-window": "7.4.1",
    "yaml": "2.9.1"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "5.3.0",
    "dexie": "4.4.6",
    "pixi.js": "8.22.0",
    "ts-fsrs": "5.4.2"
  }
}
