{
  "name": "bastion",
  "version": "0.0.0",
  "private": true,
  "description": "Offline-fähige, datenschutzstarke Lern-App für Klasse 5–13 – Baue deine Bastion.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint . && prettier --check . && pnpm check",
    "format": "prettier --write .",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tsconfig/svelte": "5.0.8",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-boundaries": "7.4.0",
    "eslint-plugin-svelte": "3.23.1",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.3",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
